# Copie para .env.local e preencha.
# Credenciais da API Higgsfield (console.higgsfield.ai) no formato key-id:key-secret
HF_CREDENTIALS=

# Opcional: protege o portal com login (usuário qualquer, esta senha).
# Recomendado em produção: sem isso, qualquer pessoa com a URL gasta seus créditos.
APP_PASSWORD=

# Opcional: Google Gemini API (aistudio.google.com → Get API key).
# Ativa "Melhorar com IA", o agente do Canvas com Gemini, Nano Banana (Imagem) e Veo 3.1 (Vídeo).
GEMINI_API_KEY=

# Opcional no Vercel: Postgres para o histórico (a integração Neon cria esta variável sozinha).
DATABASE_URL=
