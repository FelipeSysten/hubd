# Copie para .env.local e preencha.
# Credenciais da API Higgsfield (console.higgsfield.ai) no formato key-id:key-secret
HF_CREDENTIALS=

# Opcional: protege o portal com login (usuário qualquer, esta senha).
# Recomendado em produção: sem isso, qualquer pessoa com a URL gasta seus créditos.
APP_PASSWORD=
